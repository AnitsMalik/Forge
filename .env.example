# Database Configuration (MySQL)
DATABASE_URL=mysql://root:root@localhost:3308/socialforge_db
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=socialforge_db

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000/api/v1
WEB_APP_URL=http://localhost:5173

# Cryptography & Authentication
JWT_SECRET=socialforge_super_secret_jwt_key_minimum_32_chars_long_123
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=socialforge-media
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI Engine
OPENAI_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Meta Graph API Integration (Facebook Pages & Instagram Professional)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0
META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/meta/callback
META_DEV_ACCESS_TOKEN=
META_TEST_MODE=false
